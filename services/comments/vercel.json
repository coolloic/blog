{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/{@mathjax,mhchemparser,mj-context-menu,speech-rule-engine,@xmldom,wicked-good-xpath,commander}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
